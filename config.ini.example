# =============================================================
# mini-agent 配置文件（INI 风格）
#
# - 每个 [model 名称] 节定义一个模型，可任意增加多个
# - [default] 节指定不带 -m 参数时使用的默认模型
# - 以 # 或 ; 开头的行为注释
# =============================================================

[default]
model = doubao-seed

# ---------------- 示例一：DeepSeek（默认流式） ----------------
[model doubao-seed]
# 接入点：chat/completions 的完整 URL（任何 OpenAI 兼容服务均可）
endpoint = https://ark.cn-beijing.volces.com/api/coding/v3/chat/completions
# api_key 支持 env:变量名 形式，从环境变量读取，避免密钥写进文件
api_key = env:ARK_API_KEY
# 发给 API 的 model 字段（缺省时用节名 deepseek-chat）
model = doubao-seed-2.0-lite
# 上下文窗口（token）。会话估算超出时自动丢弃最早的消息；0 = 不限制
context_size = 128000
# 采样温度。设为负数或注释掉本行则不发送该参数
temperature = 0.3
# 思考深度：原样作为 reasoning_effort 发送（low/medium/high 等，视服务商而定）
# 不用则注释掉。注意：部分推理模型（如 OpenAI o 系列）不接受 temperature，
# 使用这类模型时请把 temperature 注释掉
#thinking = medium
# 流式开关：true 走 SSE 流式输出，false 等整包返回
stream = true
# 单次请求超时（秒）
timeout = 120

# ---------------- 示例二：OpenAI ----------------
[model gpt-4o]
endpoint = https://api.openai.com/v1/chat/completions
api_key = env:OPENAI_API_KEY
model = gpt-4o
context_size = 128000
temperature = 0.5
stream = true
timeout = 180

# ---------------- 示例三：本地服务（如 vLLM/ollama 的 OpenAI 兼容端点） ----------------
# [model local-qwen]
# endpoint = http://127.0.0.1:8000/v1/chat/completions
# api_key = empty
# model = qwen2.5-7b-instruct
# context_size = 32000
# temperature = 0.8
# stream = true
